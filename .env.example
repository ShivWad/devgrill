# Clerk
# NEXT_PUBLIC_ prefix is required by Next.js to expose the key to the browser.
# The agent service (@clerk/express) reads CLERK_PUBLISHABLE_KEY — server.ts
# falls back to NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY so one value covers both.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/interview
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/interview
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/

# Database (Neon)
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Redis (Upstash)
UPSTASH_REDIS_REST_URL=https://xxx-xxxxx-xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXXXXXXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# File storage
UPLOADTHING_SECRET=sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
UPLOADTHING_APP_ID=xxxxxxxxxx

# LLM APIs
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LangGraph / agent service
LANGGRAPH_SERVICE_URL=http://localhost:3001
AGENT_URL=http://localhost:3001

# Agent service security
# ALLOWED_ORIGIN: set to your Vercel production URL in Railway (comma-separated for multiple)
ALLOWED_ORIGIN=http://localhost:3000
# CLERK_SECRET_KEY is also required in the agent service to verify JWTs — copy from Clerk dashboard
# (same value as the one above; listed here as a reminder to set it in Railway env vars)

# Sentry
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@oxxxxxxx.ingest.sentry.io/xxxxxxx
